# Version control
.git
.gitignore

# Python environment and caches
.venv
**/__pycache__
**/*.pyc
.pytest_cache

# Local data: the container must not inherit the dev database
*.sql
*.db

# Docker files themselves are not needed inside the image
Dockerfile
.dockerignore

# Tests and docs are not part of the runtime image
test_*.py
README.md

.env